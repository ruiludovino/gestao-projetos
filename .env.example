# Base de dados (Neon - https://neon.tech)
# DATABASE_URL: connection pooling (pgbouncer), usada em runtime
# DIRECT_URL: ligacao direta, usada apenas para migrations do Prisma
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/gestao_projetos?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/gestao_projetos?sslmode=require"

# NextAuth / Auth.js
# Gerar com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App (https://github.com/settings/developers)
# Homepage URL: http://localhost:3000 (ou o dominio de producao)
# Callback URL: http://localhost:3000/api/auth/callback/github
# Scopes pedidos em runtime: read:user, user:email, repo (para issues/PRs/commits)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Encriptacao do cofre de credenciais (AES-256-GCM)
# Gerar com: openssl rand -hex 32   (tem de ter exatamente 64 caracteres hex = 32 bytes)
ENCRYPTION_KEY=""

# Vercel Blob (anexos de bugs) - https://vercel.com/docs/storage/vercel-blob
# Criado automaticamente ao adicionar um Blob store ao projeto na Vercel.
# Em dev local: vercel env pull .env.local (ou cria um store e copia o token)
BLOB_READ_WRITE_TOKEN=""

# Emails autorizados a criar conta sem convite (separados por virgula).
# Todos os outros precisam de ser convidados para um projeto primeiro.
OWNER_EMAILS=""

# Resend (emails de convite) - https://resend.com
# Precisa de um dominio proprio verificado no Resend para enviar para
# destinatarios arbitrarios (nao so para o teu proprio email de conta).
RESEND_API_KEY=""
